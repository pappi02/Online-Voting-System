# Email Credentials Configuration Example
# Copy this file to .env.email and update with your actual credentials

# SMTP Email Provider Configuration
# Options: gmail, outlook, sendgrid, mailgun, custom
EMAIL_PROVIDER=gmail

# Gmail Configuration (Recommended for development)
GMAIL_EMAIL_HOST=smtp.gmail.com
GMAIL_EMAIL_PORT=587
GMAIL_EMAIL_USE_TLS=True
GMAIL_EMAIL_HOST_USER=your-email@gmail.com
GMAIL_EMAIL_HOST_PASSWORD=your-app-specific-password

# Outlook/Office 365 Configuration
OUTLOOK_EMAIL_HOST=smtp-mail.outlook.com
OUTLOOK_EMAIL_PORT=587
OUTLOOK_EMAIL_USE_TLS=True
OUTLOOK_EMAIL_HOST_USER=your-email@outlook.com
OUTLOOK_EMAIL_HOST_PASSWORD=your-password

# SendGrid Configuration (Recommended for production)
SENDGRID_EMAIL_HOST=smtp.sendgrid.net
SENDGRID_EMAIL_PORT=587
SENDGRID_EMAIL_USE_TLS=True
SENDGRID_EMAIL_HOST_USER=apikey
SENDGRID_EMAIL_HOST_PASSWORD=your-sendgrid-api-key

# Mailgun Configuration
MAILGUN_EMAIL_HOST=smtp.mailgun.org
MAILGUN_EMAIL_PORT=587
MAILGUN_EMAIL_USE_TLS=True
MAILGUN_EMAIL_HOST_USER=postmaster@yourdomain.mailgun.org
MAILGUN_EMAIL_HOST_PASSWORD=your-mailgun-password

# Email Addresses
DEFAULT_FROM_EMAIL=noreply@ivotesystems.com
DEFAULT_FROM_NAME=iVote Systems
SUPPORT_EMAIL=support@ivotesystems.com
ADMIN_EMAIL=admin@ivotesystems.com

# Email Features
EMAIL_NOTIFICATION_ENABLED=True
EMAIL_VERIFICATION_REQUIRED=True
EMAIL_VERIFICATION_DEADLINE_DAYS=14
EMAIL_REMINDER_DAYS_BEFORE=7

# Development Mode (Use console backend for testing)
EMAIL_DEVELOPMENT_MODE=True
